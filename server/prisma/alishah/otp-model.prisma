// Add to schema.prisma (Huzaifa owns it). Change Int ids to String if the team uses uuids.
// Also add `otpCodes OtpCode[]` to the User model.

enum OtpPurpose {
  SIGNUP_VERIFY
  PASSWORD_RESET
}

model OtpCode {
  id        Int        @id @default(autoincrement())
  email     String                         // stored lower-case
  purpose   OtpPurpose
  userId    Int?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String                         // HMAC of the code, never the code itself
  expiresAt DateTime   @db.Timestamptz(3)  // 10 minutes after creation
  attempts  Int        @default(0)         // wrong tries; 5 kills the code
  usedAt    DateTime?  @db.Timestamptz(3)  // set when used, replaced or killed
  createdAt DateTime   @default(now()) @db.Timestamptz(3)

  @@index([email, purpose, createdAt])
}
